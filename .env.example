# Copiar a .env y reemplazar los valores genericos. No commitear .env.
# Si usa `docker compose up -d` sin cambiar compose, puede usar el mismo usuario/clave
# que en docker-compose (por defecto: facial_app / cambiar_app).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=facial_app
MYSQL_PASSWORD=cambiar_app
MYSQL_DATABASE=facial_pro_db

# Docker Compose (MySQL + phpMyAdmin)
MYSQL_ROOT_PASSWORD=cambiar_root
# Puerto web de phpMyAdmin en tu maquina (si 8090 esta ocupado, cambie, ej. 8091)
PMA_HTTP_PORT=8090

SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SECURITY_EMAIL=YOUR_SECURITY_EMAIL
